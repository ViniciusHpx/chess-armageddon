<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        Tema da Activity DEPOIS da abertura: e' este que o `BridgeActivity` do
        Capacitor aplica no `onCreate` (`setTheme(R.style.AppTheme_NoActionBar)`),
        substituindo o tema de lancamento declarado no manifesto.

        `android:windowBackground` e' o que se ve em qualquer superficie que a
        WebView nao esteja cobrindo naquele instante: os quadros entre a criacao
        da janela e o primeiro desenho da pagina, a rotacao e a propria
        pintura que o plugin SystemBars faz no decorView
        (`decorView.setBackgroundColor(themeColor(windowBackground))`). Herdado
        do `DayNight`, em aparelho no modo claro isso e' BRANCO.

        O `android:background` que estava aqui nao tem efeito nenhum como item
        de tema de janela - nao e' o atributo que o sistema le para pintar a
        janela - e por isso saiu.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appBackground</item>
    </style>


    <!--
        Tema de LANCAMENTO (o do manifesto). Vale so' ate' o `BridgeActivity`
        trocar para `AppTheme.NoActionBar`, no `onCreate`; e' a arte de abertura
        e nada mais. O `windowBackground` vai junto para a moldura em volta da
        arte nao piscar branca em tela de proporcao diferente da imagem.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/appBackground</item>
    </style>
</resources>